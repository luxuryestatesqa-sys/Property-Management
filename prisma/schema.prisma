generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// OWNER: the person who created the agency (billing/ownership, cannot be removed
// by other admins). ADMIN: full access to the agency's data and settings.
// MANAGER: sees all of the agency's leads/listings and can assign them, but
// has no settings or user management. AGENT: their own work plus shared
// listings. Existing "ADMIN" accounts keep ADMIN.
enum Role {
  OWNER
  ADMIN
  MANAGER
  AGENT
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
}

// One real-estate agency. Every user, listing and portal credential belongs to
// exactly one organization, and every query in the app is scoped to the
// signed-in user's organization (see lib/tenant.ts) so agencies can never see
// each other's data.
model Organization {
  id         String    @id @default(cuid())
  name       String
  slug       String    @unique // URL/identifier-safe short name
  logoUrl    String? // data URL or hosted image shown in the app and on share pages
  brandColor String? // hex, e.g. #8a6d1f - drives the app's primary colour
  status     OrgStatus @default(ACTIVE)
  createdAt  DateTime  @default(now())

  users           User[]
  listings        Listing[]
  credentials     PortalCredential[]
  leads           Lead[]
  leadStages      LeadStage[]
  leadActivities  LeadActivity[]
  assignmentRules AssignmentRule[]
  leadTasks       LeadTask[]
  leadGroups      LeadGroup[]
  leadGroupLinks  LeadGroupLink[]
  metaPages       MetaPage[]
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ListingType {
  RENT
  SALE
}

enum Furnished {
  FURNISHED
  UNFURNISHED
}

enum BillsStatus {
  INCLUDED
  EXCLUDED
}

// Who may see a listing. PRIVATE: only the agent who created it (and admins).
// SHARED: every agent in the company.
enum ListingVisibility {
  PRIVATE
  SHARED
}

enum ListingStatus {
  ACTIVE
  INACTIVE
}

// Real-world state of the property, independent of ListingStatus (which
// controls soft-delete / visibility in search). RENT listings use
// AVAILABLE / RESERVED / RENTED; SALE listings use AVAILABLE / RESERVED / SOLD.
enum AvailabilityStatus {
  AVAILABLE
  RESERVED
  RENTED
  SOLD
}

enum PropertyCategory {
  APARTMENT
  VILLA
  TOWNHOUSE
  PENTHOUSE
  DUPLEX
  COMPOUND_VILLA
  WHOLE_BUILDING
  OFFICE
  RETAIL
  LAND
}

// Only meaningful for residential categories (see lib/propertyCategory.ts);
// null for Office / Retail / Land.
enum BedroomCount {
  STUDIO
  ONE
  ONE_PLUS_OFFICE
  TWO
  TWO_PLUS_MAID
  THREE
  THREE_PLUS_MAID
  FOUR
  FOUR_PLUS_MAID
  FIVE
  FIVE_PLUS_MAID
  SIX_PLUS
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  email          String       @unique // a person belongs to one agency, so login stays by email alone
  whatsapp       String // mandatory WhatsApp contact number; agents can change their own, admin can correct any
  avatarUrl      String? // data URL of a resized/compressed profile photo; agents can change their own
  passwordHash   String
  role           Role         @default(AGENT)
  status         UserStatus   @default(ACTIVE)
  createdAt      DateTime     @default(now())

  // This agent's Property Finder public profile id (GET /v1/users), picked by
  // an admin from the real PF account list - never free text - so listings
  // this agent publishes are correctly attributed and their leads route to
  // them. See lib/propertyFinder/client.ts.
  pfPublicProfileId Int?

  listings       Listing[]      @relation("CreatedListings")
  auditLogs      AuditLog[]
  leads          Lead[]         @relation("AssignedLeads")
  leadActivities LeadActivity[]
  leadTasks      LeadTask[]

  @@index([status])
  @@index([role])
  @@index([organizationId])
}

// Property Finder's mandatory sale details (Qatar): the project status and how the buyer can pay.
enum ProjectStatus {
  RESALE_READY // Resale - ready to move  (PF: completed)
  RESALE_OFF_PLAN // Resale - off-plan        (PF: off_plan)
  PRIMARY_READY // Primary - ready to move  (PF: completed_primary)
  PRIMARY_OFF_PLAN // Primary - off-plan       (PF: off_plan_primary)
}

enum SalePaymentMethod {
  CASH
  INSTALLMENTS
  CASH_AND_INSTALLMENTS
}

model Listing {
  id             Int          @id @default(autoincrement())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  listingType    ListingType

  propertyCategory PropertyCategory
  bedrooms         BedroomCount? // null for non-residential categories (Office / Retail / Land)
  bathrooms        String? // Property Finder's own enum shape ("none", "1".."20"); required to publish there except Land/Farm
  sizeSqm          Float? // optional, in square meters

  // Marketing copy, not required for internal use but required to publish to
  // any external portal (Property Finder needs title.en/description.en).
  title         String?
  description   String?
  // Optional Arabic variants (Property Finder's own listing form has an
  // English/Arabic toggle for both fields - title.ar/description.ar - unlike
  // title/description above, these are never required to publish.
  titleAr       String?
  descriptionAr String?
  amenities     String[] @default([]) // Property Finder amenity enum values, filtered per lib/propertyFinder/mapping.ts

  // Property Finder's own location-tree id (GET /v1/locations), chosen by the
  // agent via autocomplete rather than derived from area/community - PF
  // recommends manual selection to avoid misassigning the listing.
  pfLocationId Int?
  // Snapshot of that Property Finder location (name, type, tree, coordinates -
  // see lib/propertyFinder/location.ts), saved when the location is chosen or
  // published. This is the location every feed and AI description uses, so
  // they show exactly what Property Finder shows; area/community above are
  // only the fallback for a listing with no Property Finder location yet.
  pfLocation   Json?

  // Location hierarchy: area (top-level location) -> community (area/community) -> buildingName -> floor -> apartmentNumber
  area            String
  community       String
  buildingName    String
  floor           String
  apartmentNumber String
  dupKey          String // normalized area|community|buildingName|floor|apartmentNumber for duplicate detection & grouping

  rentPrice   Float?
  salePrice   Float?
  rentalValue Float? // optional, only relevant for SALE listings

  // SALE listings only - Property Finder requires these to publish a sale.
  projectStatus  ProjectStatus?
  paymentMethods SalePaymentMethod?
  downPayment    Int? // QAR; 0 when no down payment is needed. Only with installments.
  mortgageYears  Int? // number of years of the installment plan. Only with installments.

  furnished   Furnished
  billsStatus BillsStatus? // only relevant for RENT listings; always null for SALE

  // Private, agent-only details - never returned to any user other than the
  // listing's own creator or an admin. See lib/listingPrivacy.ts, which
  // redacts these fields on every API response before it reaches anyone else.
  ownerName              String?
  ownerPhone             String?
  ownerWhatsapp          String?
  titleDeedNumber        String? // SALE listings only
  privateNotes           String?
  titleDeedImage         String? // data URL; SALE listings only
  authorizationFormImage String? // data URL; RENT listings only

  visibility         ListingVisibility  @default(SHARED)
  // When true, floor / apartmentNumber / dupKey are redacted for everyone but
  // the creator and admins (lib/listingPrivacy.ts), independent of visibility.
  unitDetailsPrivate Boolean            @default(false)
  status             ListingStatus      @default(ACTIVE)
  deactivatedAt      DateTime?
  availabilityStatus AvailabilityStatus @default(AVAILABLE)

  createdById String
  createdBy   User     @relation("CreatedListings", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  auditLogs      AuditLog[]
  images         ListingImage[]
  portalListings PortalListing[]
  leads          Lead[]

  @@index([area])
  @@index([community])
  @@index([buildingName])
  @@index([apartmentNumber])
  @@index([floor])
  @@index([listingType])
  @@index([rentPrice])
  @@index([salePrice])
  @@index([status])
  @@index([createdById])
  @@index([dupKey])
  @@index([availabilityStatus])
  @@index([propertyCategory])
  @@index([bedrooms])
  @@index([organizationId, status])
  @@index([organizationId, dupKey])
}

model ListingImage {
  id        String   @id @default(cuid())
  listingId Int
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String // resized/compressed JPEG data URL
  sortOrder Int      @default(0) // 0 = cover image, shown on cards
  createdAt DateTime @default(now())

  @@index([listingId])
}

model AuditLog {
  id        String   @id @default(cuid())
  listingId Int
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  oldValue  String?
  newValue  String?
  timestamp DateTime @default(now())

  @@index([listingId])
  @@index([userId])
}

// Tracks a listing's state on ONE external portal. One row per
// (listing, portal) pair, only created once an agent first opts a listing
// into that portal - a listing with no row for a portal has never been
// published there. Generic across portals (not Property-Finder-specific) so
// adding a second portal later is a new enum value + new rows, not a schema
// change or data migration.
model PortalListing {
  id        String  @id @default(cuid())
  listingId Int
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  portal    Portal

  remoteListingId String? // the portal's own id for this listing, once created
  state           String? // portal-specific state string (e.g. Property Finder's state.stage: draft / live / takendown / archived)
  enabled         Boolean @default(false) // the agent wants this published; drives the publish/unpublish flow

  // Agent-chosen reference/listing number sent to the portal instead of the
  // auto-generated default (e.g. "LE-123") - null means use the default.
  // Property Finder requires this to be unique across the whole account.
  reference String?

  // Overrides which account on this portal the listing publishes under
  // (e.g. a Property Finder public profile id) - null means "use the
  // listing's own agent's linked account for this portal"
  // (User.pfPublicProfileId today; a per-portal field if a second portal
  // ever needs its own separate account link). Set from the portal's
  // publish page, for when a listing should be attributed to a different
  // agent's account than whoever created it.
  assignedProfileId Int?

  lastSyncedAt DateTime?
  lastError    String? // most recent failure detail, shown to the agent

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([listingId, portal])
  @@index([remoteListingId])
  @@index([portal, enabled])
}

// One row per external listing portal this agency connects to - lets an
// admin manage API credentials from the Settings page instead of editing
// server env vars, and makes adding a second portal later ("later i will add
// more") an enum value + a settings card, not a schema redesign. Stored in
// plaintext (protected by admin-only access) rather than app-level
// encryption - acceptable for an internal tool now, but revisit if that
// changes.
enum Portal {
  PROPERTY_FINDER
  WEBSITE
  QATAR_LIVING
  PROPERTY_ORYX
  // The single master XML feed (/feeds/all.xml) for every portal other than
  // Property Finder - one agent-controlled switch per listing.
  OTHER_PORTALS
  // Not a portal: the OpenAI API key for "Generate with AI" is stored in the
  // same admin-managed credential table (apiKey), so it needs no new table.
  OPENAI
}

model PortalCredential {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  portal         Portal // one row per (agency, portal)

  apiKey        String?
  apiSecret     String?
  webhookSecret String?

  // Public feed/API access, shared across two different auth shapes:
  // PROPERTY_FINDER/PROPERTY_ORYX/WEBSITE use feedAgencyId+feedToken as a
  // URL query string (?agency=ID&token=SECRET) against app/feeds/[portal];
  // QATAR_LIVING uses feedToken alone as a static X-API-Key header against
  // app/api/qatar-living/listings (feedAgencyId unused there - QL's spec has
  // no agency concept). Regenerated from the settings page, not derived from
  // apiKey/apiSecret above - a portal can have a live push-API integration,
  // a pull feed/API, both, or neither.
  feedToken    String? @unique
  feedAgencyId String?

  updatedAt DateTime @updatedAt

  @@unique([organizationId, portal])
}

// ---------------------------------------------------------------------------
// Leads
// ---------------------------------------------------------------------------

enum LeadSource {
  PROPERTY_FINDER
  META // Facebook / Instagram lead ads (later)
  MANUAL
  IMPORT
}

enum LeadChannel {
  WHATSAPP
  CALL
  EMAIL
  OTHER
  FORM // a lead-form submission (Facebook / Instagram lead ads)
}

// OPEN stages are in progress; WON / LOST end a lead's life.
enum LeadStageKind {
  OPEN
  WON
  LOST
}

// The pipeline columns for one agency. Seeded with sensible defaults the first
// time a lead arrives (lib/leads/stages.ts); admins can rename/reorder later.
model LeadStage {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  position       Int
  kind           LeadStageKind @default(OPEN)
  color          String?
  createdAt      DateTime      @default(now())

  leads Lead[]

  @@unique([organizationId, name])
  @@index([organizationId, position])
}

// One enquiry from a portal / ad / manual entry. A lead is stored once, keyed by
// the source's own id (Property Finder's lead id), so webhook retries and the
// periodic sync can never create duplicates.
model Lead {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  source     LeadSource
  externalId String // the source's lead id
  channel    LeadChannel @default(OTHER)
  entityType String? // Property Finder: listing | project | developer | agent | company | seller

  name             String
  phone            String?
  email            String?
  whatsappUsername String?

  // What the portal told us. pfStatus is Property Finder's own delivery status
  // (sent / delivered / read / replied) - separate from our pipeline stage.
  pfStatus     String?
  responseLink String?
  tags         String[] @default([])

  // The property it was about, when we can tell (reference "LE-123" -> our listing).
  listingId        Int?
  listing          Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  listingReference String?
  // Area -> community of that listing (or the seller's own location for seller leads).
  region           String?

  // Who it belongs to. pfPublicProfileId is the Property Finder agent profile it
  // was sent to; assignedToId is the matching user in this agency (null = unassigned).
  pfPublicProfileId Int?
  assignedToId      String?
  assignedTo        User?   @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)

  stageId String
  stage   LeadStage @relation(fields: [stageId], references: [id])

  // Call leads
  callTalkTime  Int? // seconds
  callWaitTime  Int? // seconds
  callRecordUrl String?

  sellerProperty Json?
  raw            Json?

  receivedAt       DateTime // when it reached the source (Property Finder's createdAt)
  firstContactedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  activities LeadActivity[]
  tasks      LeadTask[]
  groupLinks LeadGroupLink[]

  @@unique([organizationId, source, externalId])
  @@index([organizationId, assignedToId])
  @@index([organizationId, stageId])
  @@index([organizationId, receivedAt])
  @@index([phone])
}

// The timeline: everything that happens to a lead, newest last when shown.
model LeadActivity {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId         String? // who did it; null for system events
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  type           String // RECEIVED | ASSIGNED | STAGE_CHANGED | PF_STATUS | NOTE | ...
  text           String?
  data           Json?
  createdAt      DateTime     @default(now())

  @@index([leadId, createdAt])
  @@index([organizationId])
}

// How new leads are routed. Rules run in order (position) and the first match wins;
// they are checked BEFORE the default routing (the Property Finder agent profile, then
// the listing owner), so a manager can steer a region or share the load.
enum AssignmentRuleKind {
  REGION // lead's region contains matchText (e.g. "Lusail")
  ROUND_ROBIN // every lead, shared across agentIds
}

model AssignmentRule {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  kind           AssignmentRuleKind
  matchText      String?
  // The agents the rule hands leads to. With more than one, the least busy
  // (fewest open leads, weighted by share) gets the next one.
  agentIds       String[]
  // { [userId]: 1-10 } - how big a share of the leads each agent gets. Missing = 1.
  shares         Json?
  position       Int
  active         Boolean            @default(true)
  createdAt      DateTime           @default(now())

  @@index([organizationId, position])
}

// A follow-up reminder on a lead ("call back Thursday 4pm"). Due tasks that are not
// done show up as "needs attention" for the agent they belong to.
model LeadTask {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedToId   String? // who has to do it (the lead's agent when created)
  assignedTo     User?        @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  text           String
  dueAt          DateTime
  doneAt         DateTime?
  createdById    String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, doneAt, dueAt])
  @@index([leadId])
  @@index([assignedToId, doneAt])
}

// Labels an agency uses to sort leads: "Hot", "Investors", "Lusail buyers"...
model LeadGroup {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  color          String?
  createdAt      DateTime        @default(now())
  links          LeadGroupLink[]

  @@unique([organizationId, name])
}

// A lead can sit in several groups.
model LeadGroupLink {
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  groupId        String
  group          LeadGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([leadId, groupId])
  @@index([groupId])
}

// A Facebook Page an agency has connected so its Facebook / Instagram lead-form leads arrive here.
// A Page can belong to one agency at a time (the webhook finds the agency from the Page id).
model MetaPage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pageId         String       @unique
  name           String
  accessToken    String // the Page access token, encrypted (lib/crypto.ts)
  fbUserId       String? // the Facebook user who connected it (for Meta's deauthorize / data deletion callbacks)
  connectedById  String? // the app user who connected it
  enabled        Boolean      @default(false) // subscribed to the leadgen webhook
  lastLeadAt     DateTime?
  lastError      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([fbUserId])
}
