# Local SQLite (default for quick local dev):
# DATABASE_URL="file:./dev.db"
# DIRECT_URL="file:./dev.db"

# Supabase / hosted Postgres (percent-encode any special characters in the
# password, e.g. "@" -> "%40", or the connection string won't parse):
#
# DATABASE_URL: the connection the app queries through at runtime. On a
# single long-running server (local dev, a VPS, Docker) the direct
# connection below is fine. On a serverless platform (Vercel) use Supabase's
# "Connection pooling" string instead (Project Settings > Database >
# Connection pooling, "Transaction" mode, port 6543) - each serverless
# invocation opens its own DB connection, and the pooler is what keeps that
# from exhausting Postgres's connection limit under real traffic.
#
# DIRECT_URL: always the direct (non-pooled) connection, port 5432. Prisma
# migrate needs this even when DATABASE_URL is pooled, since PgBouncer's
# transaction mode doesn't support what migrations require.
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

AUTH_SECRET="change-me-to-a-long-random-string"
